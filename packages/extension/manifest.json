{
  "manifest_version": 3,
  "name": "Arc SidePanel API Patcher",
  "version": "0.1.0",
  "description": "Lists installed Arc extensions that rely on chrome.sidePanel and patches them to run via a floating panel instead.",
  "key": "",
  "permissions": ["management", "nativeMessaging", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Arc SidePanel API Patcher"
  },
  "options_page": "options.html"
}
